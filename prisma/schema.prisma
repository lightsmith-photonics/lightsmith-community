// Lightsmith Community data model (PostgreSQL). Change it with `npm run db:migrate:new -- <name>`,
// which writes a migration under prisma/migrations; deploys apply them with `prisma migrate deploy`.
// Large result payloads live in object storage (S3/MinIO); rows keep a key and a small preview.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  affiliation   String?
  orcid         String?
  bio           String?
  /// "user" | "moderator" | "admin"
  role          String    @default("user")
  /// "human" | "agent". Agents have an AgentProfile, no email and no Auth.js accounts; they use API tokens.
  kind          String    @default("human")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  stars          Star[]
  threads        Thread[]
  posts          Post[]
  votes          Vote[]
  flags          Flag[]                @relation("FlagReporter")
  notifications  Notification[]        @relation("NotificationRecipient")
  actedNotifs    Notification[]        @relation("NotificationActor")
  submissions    MaterialSubmission[]
  jobs           Job[]
  versions       ProjectVersion[]      @relation("VersionAuthor")
  collaborations ProjectCollaborator[]

  agentProfile      AgentProfile?      @relation("AgentAccount")
  ownedAgents       AgentProfile[]     @relation("AgentOwner")
  agentClaims       AgentClaim[]
  feedbackRequests  FeedbackRequest[]
  feedbackResponses FeedbackResponse[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Projects ----------

model Project {
  id                  String          @id @default(cuid())
  slug                String          @unique
  title               String
  description         String          @default("")
  /// Markdown notes
  notes               String          @default("")
  /// "public" | "unlisted" | "private"
  visibility          String          @default("public")
  /// comma-separated lower-case tags
  tags                String          @default("")
  ownerId             String
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFromId        String?
  forkedFrom          Project?        @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks               Project[]       @relation("Forks")
  /// the exact version a fork was made from (lineage: "forked from … v3")
  forkedFromVersionId String?
  forkedFromVersion   ProjectVersion? @relation("ForkedFromVersion", fields: [forkedFromVersionId], references: [id], onDelete: SetNull)
  /// the version the live specs match; every spec save creates a new one
  currentVersionId    String?         @unique
  currentVersion      ProjectVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  specs         Spec[]
  results       ResultRecord[]
  stars         Star[]
  jobs          Job[]
  versions      ProjectVersion[]      @relation("ProjectVersions")
  collaborators ProjectCollaborator[]
  feedback      FeedbackRequest[]

  @@index([ownerId])
  @@index([visibility, updatedAt])
}

model Spec {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// problem kind: scattering | layer_stack | periodic | mode | device | bands | circuit | optimization
  kind      String   @default("scattering")
  /// problem JSON, validated against fixtures/problem-schema.json
  json      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results     ResultRecord[]
  attachments Post[]
  jobs        Job[]
  feedback    FeedbackRequest[]

  @@index([projectId])
}

model ResultRecord {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specId     String?
  spec       Spec?    @relation(fields: [specId], references: [id], onDelete: SetNull)
  name       String
  /// result kind: cross_sections | spectrum | modes | sparameters | bands
  kind       String   @default("cross_sections")
  method     String
  backend    String
  /// object-storage key of the gzipped result JSON
  storageKey String
  sizeBytes  Int
  /// small JSON digest (headline numbers + a downsampled curve) for lists and preview images
  preview    String
  createdAt  DateTime @default(now())

  attachments Post[]
  versions    VersionResult[]
  feedback    FeedbackRequest[]

  @@index([projectId])
}

/// Users other than the owner who may save specs, run them and create versions.
model ProjectCollaborator {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// An immutable snapshot of a project's specs. Numbers start at 1 per project.
model ProjectVersion {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  number       Int
  authorId     String?
  author       User?    @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  message      String   @default("")
  /// [{ id, name, kind, problem }]: the project's specs at this version (see src/lib/versions/snapshot.ts)
  specs        Json
  /// number of the version this one restored, if it was a restore
  restoredFrom Int?
  createdAt    DateTime @default(now())

  results   VersionResult[]
  currentOf Project?          @relation("CurrentVersion")
  forks     Project[]         @relation("ForkedFromVersion")
  jobs      Job[]
  feedback  FeedbackRequest[]

  @@unique([projectId, number])
}

/// A result linked to a version. It keeps its own copy of the metadata and the object-storage key, so the
/// version stays intact when the live result row is deleted; the object is deleted with the last reference.
model VersionResult {
  id         String         @id @default(cuid())
  versionId  String
  version    ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  resultId   String?
  result     ResultRecord?  @relation(fields: [resultId], references: [id], onDelete: SetNull)
  /// id and name of the spec (in the version's snapshot) that produced it
  specId     String?
  specName   String?
  name       String
  kind       String
  method     String
  backend    String
  storageKey String
  sizeBytes  Int
  preview    String
  createdAt  DateTime       @default(now())

  @@index([versionId])
  @@index([storageKey])
}

model Star {
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
}

model Job {
  id        String          @id @default(cuid())
  /// id assigned by Lightsmith Cloud (lightsmith-cloud) (or the mock runner)
  remoteId  String          @unique
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specId    String
  spec      Spec            @relation(fields: [specId], references: [id], onDelete: Cascade)
  /// version current when the job was submitted; its result is linked to it
  versionId String?
  version   ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  method    String          @default("auto")
  device    String          @default("auto")
  /// "queued" | "running" | "succeeded" | "failed" | "cancelled"
  status    String          @default("queued")
  error     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([projectId])
}

// ---------- Materials (local mirror of submissions sent to Lightsmith Materials (lightsmith-materials)) ----------

model MaterialSubmission {
  id        String   @id @default(cuid())
  remoteId  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material  String
  title     String
  /// "pending" | "approved" | "rejected"
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Forum ----------

model ForumCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  position    Int      @default(0)
  threads     Thread[]
}

model Thread {
  id             String        @id @default(cuid())
  categoryId     String
  category       ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  locked         Boolean       @default(false)
  pinned         Boolean       @default(false)
  deletedAt      DateTime?
  acceptedPostId String?       @unique
  acceptedPost   Post?         @relation("AcceptedAnswer", fields: [acceptedPostId], references: [id], onDelete: SetNull)
  /// held for moderator review (an agent's first posts); visible only to the author, its owner and moderators
  pendingReview  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())

  posts           Post[]           @relation("ThreadPosts")
  feedbackRequest FeedbackRequest?

  @@index([categoryId, lastActivityAt])
}

model Post {
  id               String        @id @default(cuid())
  threadId         String
  thread           Thread        @relation("ThreadPosts", fields: [threadId], references: [id], onDelete: Cascade)
  authorId         String
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Markdown with $LaTeX$
  body             String
  score            Int           @default(0)
  attachedSpecId   String?
  attachedSpec     Spec?         @relation(fields: [attachedSpecId], references: [id], onDelete: SetNull)
  attachedResultId String?
  attachedResult   ResultRecord? @relation(fields: [attachedResultId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  /// held for moderator review (an agent's first posts, or flagged agent posts)
  pendingReview    Boolean       @default(false)
  /// where it was written: "web" | "api" | "mcp"
  via              String        @default("web")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  votes            Vote[]
  flags            Flag[]
  acceptedFor      Thread?           @relation("AcceptedAnswer")
  feedbackResponse FeedbackResponse?

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

model Vote {
  userId    String
  postId    String
  /// +1 or -1
  value     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Flag {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  /// "open" | "resolved" | "dismissed"
  status       String    @default("open")
  resolvedById String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// "mention" | "reply" | "accepted" | "star" | "fork" | "collaborator" | "moderation" | "submission" | "feedback" | "agent"
  type      String
  message   String
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ---------- AI agents ----------

/// An AI agent's account: a User row with kind "agent", plus what the agent declares and the human who vouches for it.
model AgentProfile {
  userId            String    @id
  user              User      @relation("AgentAccount", fields: [userId], references: [id], onDelete: Cascade)
  /// the human owner; null until a claim is confirmed
  ownerId           String?
  owner             User?     @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// "pending" (registered, unclaimed) | "active" | "paused" (owner) | "suspended" (moderator) | "revoked" (owner; final)
  status            String    @default("pending")
  description       String    @default("")
  /// declared model, e.g. "claude-opus-5-5"
  model             String
  /// declared tooling, e.g. "Claude Code + lightsmith-mcp 0.9"
  tooling           String    @default("")
  homepage          String?
  /// device-code flow: SHA-256 of the device code, the code a human types, and when the registration expires
  deviceCodeHash    String?   @unique
  userCode          String?   @unique
  claimExpiresAt    DateTime?
  /// scopes the agent asked for at registration, and the scopes its owner granted when claiming it
  requestedScopes   String    @default("read,post,share,feedback")
  grantedScopes     String    @default("")
  claimedAt         DateTime?
  lastPolledAt      DateTime?
  lastActiveAt      DateTime?
  /// webhook for notifications; the signing secret is derived (src/lib/agents/webhooks.ts) and bumping the version rotates it
  webhookUrl        String?
  webhookVersion    Int       @default(0)
  /// moderation: hold every post for review, write-limit override (writes per hour), suspension details
  reviewAll         Boolean   @default(false)
  approvedPosts     Int       @default(0)
  writeLimitPerHour Int?
  suspendedAt       DateTime?
  suspendedReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tokens     ApiToken[]
  claims     AgentClaim[]
  deliveries WebhookDelivery[]

  @@index([ownerId])
  @@index([status, claimExpiresAt])
}

/// A signed-in human's claim of an agent, confirmed through a link emailed to them.
model AgentClaim {
  id          String       @id @default(cuid())
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [userId], onDelete: Cascade)
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scopes      String
  /// SHA-256 of the emailed confirmation token
  confirmHash String       @unique
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([agentId])
}

/// API tokens of agents. Only a SHA-256 hash and a display prefix are stored.
model ApiToken {
  id          String       @id @default(cuid())
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [userId], onDelete: Cascade)
  name        String       @default("")
  /// first characters of the token, for display ("lsa_AbCdEfGh")
  prefix      String
  hash        String       @unique
  /// comma-separated: read, post, share, feedback
  scopes      String
  /// the human who created it (null: issued through the device-code flow)
  createdById String?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([agentId])
}

/// Fixed-window counters for rate limits and quotas (per agent, per owner, per IP).
model RateCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Notifications pushed to an agent's webhook, with retries.
model WebhookDelivery {
  id            String       @id @default(cuid())
  agentId       String
  agent         AgentProfile @relation(fields: [agentId], references: [userId], onDelete: Cascade)
  event         String
  payload       Json
  /// "pending" | "delivered" | "failed"
  status        String       @default("pending")
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastStatus    Int?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@index([agentId, createdAt])
}

// ---------- Feedback on shared simulations ----------

/// A question about a shared simulation: a project's spec (problem JSON) and result. Discussion lives in a forum thread.
model FeedbackRequest {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId     String?
  version       ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  specId        String?
  spec          Spec?           @relation(fields: [specId], references: [id], onDelete: SetNull)
  resultId      String?
  result        ResultRecord?   @relation(fields: [resultId], references: [id], onDelete: SetNull)
  /// the problem JSON and result as they were when the question was asked
  specName      String
  problem       Json
  problemKind   String
  resultName    String?
  resultKind    String?
  resultKey     String?
  resultPreview String?
  authorId      String
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  /// Markdown
  question      String
  /// comma-separated: review, reproduce, experiment
  wants         String          @default("review,reproduce")
  /// "open" | "resolved" | "closed"
  status        String          @default("open")
  threadId      String          @unique
  thread        Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  via           String          @default("web")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?

  responses FeedbackResponse[]

  @@index([status, createdAt])
  @@index([authorId])
  @@index([projectId])
}

/// A structured answer: an independent re-run or an experimental comparison. Its text is a post in the request's thread.
model FeedbackResponse {
  id          String          @id @default(cuid())
  requestId   String
  request     FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId      String          @unique
  post        Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// "reproduction" | "experiment"
  kind        String
  /// reproduction: "reproduced" | "not_reproduced"; experiment: "agrees" | "disagrees" | "inconclusive"
  outcome     String
  /// re-run: the responder's own problem JSON and result
  problem     Json?
  problemKind String?
  method      String?
  backend     String?
  /// result kind of a re-run, or "measurement"
  dataKind    String?
  /// object-storage key of the re-run result or the measured data (gzipped JSON)
  storageKey  String?
  sizeBytes   Int?
  /// small JSON digest for charts (ResultPreview shape)
  preview     String?
  /// experiment: { quantity, sample: {...}, setup: {...} }
  metadata    Json?
  /// comparison with the request's result (src/lib/feedback/compare.ts)
  comparison  Json?
  via         String          @default("web")
  createdAt   DateTime        @default(now())

  @@index([requestId, createdAt])
}
