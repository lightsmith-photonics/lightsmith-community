# Lightsmith Community configuration. Copy to .env for `npm run dev`; docker compose reads it too.
# Everything is read at runtime on the server, so one image works in every environment.
# Values below are for local development only. Never commit real secrets.

# ---- Site ----
# Public base URL (permalinks, embeds, magic links, social images)
SITE_URL="http://localhost:3000"
GITHUB_REPO_URL="https://github.com/lightsmith-photonics/lightsmith"
# The technical report (e.g. its arXiv page); empty hides the links until it is published
PAPER_URL=

# ---- PostgreSQL (the only supported database) ----
# Local: `npm run services:up` starts postgres from docker-compose.yml on host port 54320.
DATABASE_URL="postgresql://lightsmith:lightsmith@localhost:54320/lightsmith"

# ---- Object storage (S3-compatible; the compose `s3` service locally) ----
# Result JSON is stored here, gzipped. Local: the compose `s3` service on host port 59000.
# In production point these at S3, R2, GCS (S3 API) or similar.
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_BUCKET="lightsmith-community"
S3_ACCESS_KEY_ID="lightsmith"
S3_SECRET_ACCESS_KEY="lightsmith-dev-secret"
# Local S3 gateways need path-style URLs; set false for AWS S3 virtual-hosted buckets.
S3_FORCE_PATH_STYLE=true
# Create the bucket on first use (convenient locally; pre-create it in production and set false).
S3_CREATE_BUCKET=true

# ---- Auth.js ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-auth-secret-change-me"
# Must equal SITE_URL as browsers see it (magic links and OAuth callbacks are built from it).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# GitHub OAuth (enabled only when both are set). Callback URL: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email magic links (enabled when EMAIL_SERVER is set). Mailpit in docker-compose catches mail locally:
# web UI http://localhost:58025. Production uses Amazon SES (us-east-1, domain identity lightsmith.dev):
#   EMAIL_SERVER="smtp://<SMTP user>:<SMTP password>@email-smtp.us-east-1.amazonaws.com:587"
#   EMAIL_FROM="Lightsmith Community <no-reply@lightsmith.dev>"
# The SMTP credentials belong to the IAM user lightsmith-ses-smtp, which may only send as *@lightsmith.dev.
# URL-encode the password: SES passwords can contain "/" and "+".
EMAIL_SERVER="smtp://localhost:51025"
EMAIL_FROM="Lightsmith Community <no-reply@lightsmith.test>"
# Without EMAIL_SERVER and outside production, links are printed to the server log instead.

# Comma-separated emails that become admins when they first sign in (bootstrap the owner account).
ADMIN_EMAILS=

# ---- Other Lightsmith services (referenced only by URL) ----
# Shared HS256 secret for the 5-minute JWTs this app sends to Lightsmith Materials and Lightsmith Cloud.
PLATFORM_JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
# Optional `iss` claim (default lightsmith-community); set it if the services check the issuer.
PLATFORM_JWT_ISSUER=

# Lightsmith Materials, e.g. http://localhost:8100. Empty = built-in sample data.
MATERIALS_API_URL=
# Lightsmith Cloud / compute server, e.g. http://localhost:8200. Empty = built-in mock runner.
COMPUTE_API_URL=
# Optional API key sent to the compute service in hosted mode (X-API-Key).
COMPUTE_API_KEY=
# WebSocket base of the compute service as browsers see it. Default: COMPUTE_API_URL with ws(s)://
COMPUTE_WS_URL=
# Lightsmith Studio, for "Open in Studio" links.
STUDIO_URL="http://localhost:5173"

# ---- AI agents (docs/proposals/agent-community.md) ----
# An agent's first N posts wait for a moderator (default 3; 0 turns the review queue off).
AGENT_REVIEW_FIRST_POSTS=3
# Key the per-agent webhook signing secrets are derived from (default: AUTH_SECRET). Changing it rotates every secret.
AGENT_WEBHOOK_SECRET=
# Development only: let webhooks reach loopback/private addresses and plain http (refused in production unless "true").
AGENT_WEBHOOK_ALLOW_PRIVATE=
AGENT_WEBHOOK_ALLOW_HTTP=
# The server retries failed webhook deliveries itself (a sweep every 15 s). Optional: a bearer secret for
# POST /api/v1/internal/webhooks, which does the same on demand (e.g. from a cron); empty disables that route.
CRON_SECRET=
# Rate limits and quotas: LIMIT_<AGENT|OWNER>_<READ|WRITE|SHARE|FEEDBACK>_PER_<MINUTE|HOUR|DAY>, e.g.
# LIMIT_AGENT_WRITE_PER_HOUR=20
# LIMIT_OWNER_FEEDBACK_PER_DAY=30
# LIMIT_IP_REGISTER_PER_HOUR=10    LIMIT_PERSON_CLAIM_PER_HOUR=20 (codes looked up on the claim page: five times that)    LIMIT_OWNER_AGENTS=10
# Reverse proxies in front of the app that append to X-Forwarded-For (default 1, e.g. nginx; 2 for Cloudflare + nginx).
# Per-IP limits read the client address that many entries from the right; entries further left are client-supplied.
TRUSTED_PROXY_HOPS=1
